// The Worker in workers/api. This file is at the repository root because the
// Deploy to Cloudflare button reads the Wrangler configuration at the root of
// the repository it copies. Wrangler commands run in workers/api find it here.
{
  "$schema": "workers/api/node_modules/wrangler/config-schema.json",
  "name": "ntasks",
  "main": "workers/api/src/index.ts",
  // From compatibility date 2026-08-04 the runtime includes Node's built-in
  // modules without the nodejs_compat flag; workers/api/tsconfig.json types
  // them.
  "compatibility_date": "2026-11-06",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // The web app, built by apps/web. A path listed in run_worker_first reaches
  // this Worker. Any other path is served from the build; a page address with
  // no file of its own serves index.html, and the app routes it. All of /api/*
  // is listed, so an API client asking for a path that does not exist gets
  // the Worker's JSON 404, never the app's HTML. The sign-in pages and the
  // OAuth discovery documents MCP clients read are the Worker's too
  // (workers/api/src/access/protocol.ts).
  "assets": {
    "directory": "apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/healthz",
      "/api/*",
      "/sign-in",
      "/agent-access",
      "/.well-known/oauth-authorization-server",
      "/.well-known/oauth-authorization-server/*",
      "/.well-known/oauth-protected-resource/*"
    ]
  },
  // Sign-in's one required secret; docs/sign-in.md describes it and the
  // optional ones. The Deploy to Cloudflare button asks for the ones
  // .dev.vars.example names, `wrangler secret put` sets them on any other
  // deployment, and .dev.vars beside this file holds them locally.
  // `wrangler deploy` refuses a Worker that lacks a required one, and a
  // malformed one turns sign-in off. The setup page at /sign-in registers the
  // GitHub App people sign in through.
  "secrets": {
    "required": ["AUTH_SECRET"]
  },
  // About 30 sign-in requests a minute from one address; about 3 agent
  // registrations, and separately 3 setup attempts, a minute from one
  // address; 10 registrations, and separately 10 setup attempts, a minute
  // from all addresses together. An IPv6 address counts by its /64 block.
  // Each registration writes to D1 without anyone signed in, and the free
  // plan's daily write limit stops every query once reached.
  // Cloudflare counts each limit separately in each of its locations, so the
  // numbers are approximate. namespace_id names a limiter within the account;
  // it is not a secret.
  "ratelimits": [
    {
      "name": "SIGN_IN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "REGISTER_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "REGISTER_ADDRESS_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  // The task stores: one Durable Object for each workspace, named
  // 'workspace:' followed by the workspace's id, each with its own SQLite
  // database (workers/api/src/store). A store is created by the first request
  // that names it, and `wrangler dev` and the tests keep theirs locally.
  "durable_objects": {
    "bindings": [{ "name": "TASK_STORE", "class_name": "TaskStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TaskStore"] }],
  // The store's schema and task templates are imported as text.
  "rules": [
    { "type": "Text", "globs": ["**/*.sql", "**/skills/ntasks/templates/*.md"], "fallthrough": true }
  ],
  // D1 holds the data that is not tasks, from the files in migrations_dir.
  // database_id is left out. The Deploy to Cloudflare button creates the
  // database and writes its id into the copy of the repository it makes;
  // otherwise the first `wrangler deploy` creates it (wrangler's automatic
  // provisioning). Commands name the database by its binding, DB, so they
  // work when the button gave it another name.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ntasks",
      "migrations_dir": "workers/api/migrations"
    }
  ]
}
