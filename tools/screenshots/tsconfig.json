{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The script is a Node program.
    "types": ["node"],
    // Node runs this source as it is, by stripping its types. Node's module
    // rules make every relative import name its file, and erasableSyntaxOnly
    // refuses TypeScript syntax that Node cannot strip.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "erasableSyntaxOnly": true
  },
  "include": ["src"]
}
