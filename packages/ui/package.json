{
  "name": "@notice-cx/ntasks-ui",
  "version": "0.4.0",
  "description": "The Ntasks web app as a React component a host page renders: the board, a task, Focus, Live, Projects, Members and Settings, acting as the signed-in person.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/notice-cx/Ntasks/tree/main/packages/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notice-cx/Ntasks.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/notice-cx/Ntasks/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "ntasks-source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixture": {
      "ntasks-source": "./src/fixture.ts",
      "types": "./dist/types/fixture.d.ts",
      "default": "./dist/fixture.js"
    },
    "./styles.css": "./dist/ntasks-ui.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./fixture": {
        "types": "./dist/types/fixture.d.ts",
        "default": "./dist/fixture.js"
      },
      "./styles.css": "./dist/ntasks-ui.css"
    }
  },
  "scripts": {
    "dev": "vite --mode fixture",
    "typecheck": "tsc && tsc -p test && tsc -p scripts",
    "test": "vitest run",
    "build": "vite build && node scripts/declarations.ts",
    "check:host": "node scripts/check-host.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.106.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "highlight.js": "11.12.0",
    "lucide-react": "1.70.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@ntasks/domain": "workspace:*",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
