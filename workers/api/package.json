{
  "name": "@ntasks/api",
  "version": "0.0.0",
  "private": true,
  "description": "The Ntasks Worker: the HTTP API over one D1 database, and the host of the web app.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "wrangler types --check && tsc && tsc -p test && tsc -p test/node",
    "test": "vitest run && node --test test/node/routing.ts",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@ntasks/web": "workspace:*",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "@ntasks/domain": "workspace:*"
  }
}
