{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ntasks",
  "main": "src/index.ts",
  // From compatibility date 2026-08-04 the runtime includes Node's built-in
  // modules without the nodejs_compat flag; tsconfig.json types them.
  "compatibility_date": "2026-11-06",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // The web app, built by apps/web. A path listed in run_worker_first reaches
  // this Worker. Any other path is served from the build; a page address with
  // no file of its own serves index.html, and the app routes it. All of /api/*
  // is listed, so an API client asking for a path that does not exist gets
  // the Worker's JSON 404, never the app's HTML. The sign-in pages and the
  // OAuth discovery documents MCP clients read are the Worker's too
  // (src/access/protocol.ts).
  "assets": {
    "directory": "../../apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/healthz",
      "/api/*",
      "/sign-in",
      "/agent-access",
      "/.well-known/oauth-authorization-server",
      "/.well-known/oauth-authorization-server/*",
      "/.well-known/oauth-protected-resource/*"
    ]
  },
  // Sign-in settings, set with `wrangler secret put` on a deployment and in
  // .dev.vars locally; docs/sign-in.md lists them. Without them sign-in is
  // off and every call that needs a signed-in sender is refused.
  "secrets": {
    "required": ["NTASKS_ORIGIN", "AUTH_SECRET", "GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "OWNER_GITHUB_IDS"]
  },
  // About 30 sign-in requests a minute from one address; about 3 agent
  // registrations a minute from one address and 10 from all addresses
  // together. Each registration writes to D1 without anyone signed in, and
  // the free plan's daily write limit stops every query once reached.
  // Cloudflare counts each limit separately in each of its locations, so the
  // numbers are approximate. namespace_id names a limiter within the account;
  // it is not a secret.
  "ratelimits": [
    {
      "name": "SIGN_IN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "REGISTER_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "REGISTER_ADDRESS_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  // The task store. database_id is left out: the first `wrangler deploy`
  // creates the database (wrangler's automatic provisioning). `wrangler dev`
  // and the tests use a local database, so neither needs an account.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ntasks"
    }
  ]
}
