{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ntasks",
  "main": "src/index.ts",
  // From compatibility date 2026-08-04 the runtime includes Node's built-in
  // modules without the nodejs_compat flag; tsconfig.json types them.
  "compatibility_date": "2026-11-06",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // The web app, built by apps/web. A path listed in run_worker_first reaches
  // this Worker. Any other path is served from the build; a page address with
  // no file of its own serves index.html, and the app routes it. All of /api/*
  // is listed, so an API client asking for a path that does not exist gets
  // the Worker's JSON 404, never the app's HTML.
  "assets": {
    "directory": "../../apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/healthz", "/api/*"]
  },
  // The one workspace this installation serves. Agents name it on every task
  // tool call, as they named a NoticeOS workspace; an installation that takes
  // over from NoticeOS sets WORKSPACE_ID to that workspace's id, so agents'
  // instructions keep working.
  "vars": {
    "WORKSPACE_ID": "default",
    "WORKSPACE_NAME": "Ntasks"
  },
  // The task store: one Durable Object with its own SQLite database
  // (src/store). A store is created by the first request that names it, and
  // `wrangler dev` and the tests keep theirs locally.
  "durable_objects": {
    "bindings": [{ "name": "TASK_STORE", "class_name": "TaskStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TaskStore"] }],
  // The store's schema files are imported as text (src/store/schema.ts).
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // D1 holds the data that is not tasks, from the files in migrations/.
  // database_id is left out: the first `wrangler deploy` creates the database
  // (wrangler's automatic provisioning).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ntasks"
    }
  ]
}
