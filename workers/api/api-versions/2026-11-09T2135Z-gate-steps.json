{
  "added": "`steps` on a task, `POST /api/gates/:id/steps`, and `step` among a person's `operations` in `GET /api/tasks/capabilities`",
  "shapes": {
    "task": {
      "steps": "array|null",
      "steps[]": "object",
      "steps[].text": "string",
      "steps[].command": "null|string",
      "steps[].done": "null|object",
      "steps[].done.by": "string",
      "steps[].done.app": "absent|string",
      "steps[].done.at": "string",
      "steps[].note": "null|object",
      "steps[].note.text": "string",
      "steps[].note.by": "string",
      "steps[].note.app": "absent|string",
      "steps[].note.at": "string",
      "steps[].stuck": "null|object",
      "steps[].stuck.reason": "string",
      "steps[].stuck.by": "string",
      "steps[].stuck.app": "absent|string",
      "steps[].stuck.at": "string"
    }
  },
  "routes": {
    "POST /api/gates/:id/steps": {
      "task": "@task"
    }
  }
}
