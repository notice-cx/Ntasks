{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The tests read the schemas and samples from disk, and the conformance
    // suite runs in Node as it is written.
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "erasableSyntaxOnly": true
  },
  "include": ["test", "conformance"]
}
