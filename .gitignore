# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# VitePress's cache, which `vitepress dev` writes beside each site's config
**/.vitepress/cache/

# the HTTP API's versions, listed from workers/api/api-versions/ by
# workers/api/scripts/api-versions.ts on install and before every build and test
workers/api/src/api-versions.generated.json

# test output
coverage/

# wrangler's local state: the local D1 database, caches and logs
.wrangler/

# secrets and local settings; .dev.vars.example names the secrets and holds none
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*

# macOS
.DS_Store
